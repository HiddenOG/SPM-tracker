# Environment
.env
.env.*

# Python
__pycache__/
*.pyc
*.pyo
venv/
.venv/
*.egg-info/

# Local data & attachments — never upload
data/
*.pdf

# Front end: dependencies and the Vite build are made, not kept
node_modules/
frontend/dist/

# Dev/test artifacts
.pytest_cache/
.claude/
archive/

# OS
.DS_Store
Thumbs.db

# Office temp/lock files
~$*

# Loose working documents dropped in the project root — customer
# spreadsheets, screenshots and proposals are not source code.
# Root-anchored so the app's own assets under data_fl/ stay tracked.
/*.xlsx
/*.xls
/*.docx
/*.jpeg
/*.jpg

# Runtime logs
logs/

# Generated reports - contain customer and pricing data
exports/
